{
  "name": "@source-os/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "generate:api": "openapi-typescript ../../docs/openapi.json -o src/api/schema.ts",
    "check:api": "pnpm generate:api && git diff --exit-code -- src/api/schema.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^7.9.0",
    "@tanstack/react-query": "^5.90.0",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.0",
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vitest": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/user-event": "^14.6.0",
    "jsdom": "^27.0.0",
    "@playwright/test": "^1.56.0",
    "openapi-typescript": "^7.10.0"
  }
}
